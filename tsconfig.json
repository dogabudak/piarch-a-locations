{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "es6",
    "lib": ["es2019"],
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["./src/**/*", "./index.ts", "./cluster.ts"],
  "exclude": [
    "node_modules"
  ]
}
